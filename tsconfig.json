{
  "extends": "@freckle/tsconfig/library.json",
  "compilerOptions": {
    // The package touches the DOM (jQuery ajax), which the base lib does not include
    "lib": ["ES2023", "DOM"],
    "rootDir": "src",
    "outDir": "dist",
    // jquery for the DOM typings above, vitest/globals for the test files
    "types": ["jquery", "vitest/globals"]
  },
  "include": ["src/**/*.ts"]
}
